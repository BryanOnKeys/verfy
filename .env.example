# Verfy environment variables. Copy to .env.local for local development.
# Never commit real values. In Vercel, set them under Project Settings > Environment Variables.

# --- Public (shipped to the browser; safe only because RLS protects every table) ---
# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (sb_publishable_...). Legacy projects may use the anon key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The public URL of this app, no trailing slash, e.g. https://verfy.example.com (http://localhost:3000 locally)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to "true" only after GitHub is enabled under Supabase > Authentication > Providers.
# The GitHub OAuth client ID and secret are entered in the Supabase dashboard, not here.
NEXT_PUBLIC_AUTH_GITHUB_ENABLED=false
# `true` only after Google is set up in Supabase (Authentication > Providers > Google)
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
# Optional: the Google OAuth web client ID (public). When set, Google returns to /auth/google on this app
# instead of the Supabase domain; add <app url>/auth/google to the client's authorized redirect URIs.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Optional: Cloudflare Turnstile SITE key. When set, sign-in, sign-up and password-reset forms show a CAPTCHA.
# Put the matching SECRET key in Supabase > Authentication > Attack Protection (never here).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Server only (never prefix with NEXT_PUBLIC_, never expose to the browser) ---
# Supabase secret key (sb_secret_...). Bypasses RLS; used only in server code after
# Verfy has checked the caller (device token ingest, enrollment, exports, rate limits).
# Legacy projects may use the service_role key here.
SUPABASE_SECRET_KEY=
# Random string (>= 32 chars) used to hash client IP addresses for rate limiting,
# so raw IPs are never stored. Generate: openssl rand -base64 48
ATLS_IP_HASH_SALT=
